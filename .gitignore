# Dependencies & build
node_modules/
dist/
build/
.next/
.vercel/

# Test / coverage
coverage/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# User-generated uploads (Multer, local files)
# Keep `.gitkeep` so the empty folder still exists when someone clones the repo.
server/uploads/**
!server/uploads/.gitkeep
uploads/**
!uploads/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE / tooling
.idea/
*.swp
*.swo

# Logs & caches
*.log
npm-debug.log*
.pnpm-debug.log*
.turbo/

# Python (if added later)
.venv/
__pycache__/
*.py[cod]

# Note: package-lock.json is intentionally NOT ignored — commit it for reproducible installs.
